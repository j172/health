# BEGIN health-app managed cron
# Managed by deploy-crontab.sh — all health-app entries must reside within BEGIN/END markers.
# Self-heal watchdog trigger for health-web (Next.js)
*/5 * * * * curl -s --max-time 90 --insecure --resolve "health.j172.tw:443:103.21.221.12" "https://health.j172.tw/__ops/pm2-ensure-running?key=__OPS_KEY__&cb=$(date +\%s)" >> /home/tw123457/health_app/logs/pm2-watchdog-cron.log 2>&1
#
# Independent dead-man's-switch liveness ping (healthchecks.io)
*/5 * * * * curl -fsS --max-time 15 --insecure --resolve "health.j172.tw:443:103.21.221.12" "https://health.j172.tw/news" >/dev/null 2>&1 && curl -fsS --max-time 10 "__HEALTHCHECKS_URL__" >> /home/tw123457/health_app/logs/healthchecks-ping-cron.log 2>&1
# END health-app managed cron
