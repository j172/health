# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.vscode
# testing
/coverage

# next.js
/.next/
/.next2/
/.next3/
/out/
tsconfig.tsbuildinfo

# contentlayer
.contentlayer

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# SSH credentials
/.ssh/

# runtime-downloaded card images (Pixabay/Pexels/Unsplash) and re-hosted article images
/public/images/news/pixabay/
/public/images/news/pexels/
/public/images/news/unsplash/
/public/images/news/articles/

# build-time-generated source-branded og:image placeholders (scripts/generate-source-og-images.mjs) —
# regenerated fresh on every deploy, not committed (see ops_health_502_watchdog memory:
# next/og's ImageResponse can't run on the production host itself, only at build time on the GHA runner)
/public/images/og/source/

# vercel
.vercel

# local deploy scratch/diagnostic files (server dumps, prebuilt bundles, logs)
/.prebuilt-next*.tgz
/.remote-prebuilt-next*.tgz
/_remote_*.txt
/_remote_*.php
/health-web-*.log
/remote_env.txt
/root_htaccess.txt