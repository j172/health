MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=false
RSS_SYNC_ADMIN_SECRET=
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APPLICATION_ID=
APP_BASE_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Cloudflare Web Analytics (no-cookie) beacon token — issue #456. Get this
# from the Cloudflare dashboard (Analytics > Web Analytics > Manage Site >
# "I'll add the JavaScript snippet myself to my page"). Beacon is a no-op
# until this is set.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
MOENV_AQI_API_KEY=
OPENCAGE_API_KEY=
OPENCAGE_API_KEY2=
CWA_API_KEY=
MOENV_NEWS_API_KEY=
MOENV_GP_API_KEY=
# TGOS Address Geocoding (TGOS_APP_ID or TGOS_APPID)
TGOS_APP_ID=
TGOS_API_KEY=
# WAQI (World Air Quality Index Project) real-time AQI tile API token —
# issue #598. Free, non-commercial-use token from https://aqicn.org/data-platform/token/.
# Read server-side (lib/server/config/env.ts) and handed to the browser as a
# prop so /tools/global-watch/air-quality can request WAQI's raster AQI
# tiles directly from the client; no-op (shows a "not configured" message)
# until this is set.
WAQI_TOKEN=
# Google Gemini API free-tier key (https://aistudio.google.com/apikey) —
# optional zero-cost fallback/alternative for Cloudflare Workers AI in
# lib/server/cloudflare/aiClient.ts (uses gemini-2.5-flash-lite via REST).
GEMINI_API_KEY=